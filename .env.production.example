# Production Environment Variables for Vercel Deployment
# Set these in Vercel Dashboard -> Project Settings -> Environment Variables

# API Server URL (REQUIRED for production)
NEXT_PUBLIC_API_BASE=https://your-api-server.com

# Optional: Discord Client ID for OAuth
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id

# Development only (not used in production)
# NEXT_PUBLIC_API_BASE=http://localhost:3001
