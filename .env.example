# Discord bot token (bot account secret)
DISCORD_TOKEN=
# Discord application/client ID used when registering commands
DISCORD_CLIENT_ID=
# Guild (server) where the verification happens
GUILD_ID=
# Role to grant upon successful verification
MEMBER_ROLE_ID=
# Optional staff role ID allowed to run admin commands without needing Manage Server permission
STAFF_ROLE_ID=
# Text channel ID where the welcome greeting should be posted
WELCOME_CHANNEL_ID=
# Public URL for the Next.js frontend (used in verification DMs)
PUBLIC_FRONTEND_URL=
# Base URL for this backend API (consumed by the Next.js frontend)
API_BASE_URL=
# MongoDB Atlas connection string (required)
MONGO_URI=
# Google reCAPTCHA v2 site key (safe to expose to the client)
RECAPTCHA_SITE_KEY=
# Google reCAPTCHA v2 secret key (server-side only)
RECAPTCHA_SECRET_KEY=
# Shared secret for accessing the admin dashboard API endpoint
ADMIN_KEY=
# Optional: Discord invite or server link opened by the "Open in Browser" button
DISCORD_BROWSER_URL=
# Port for the Express API + bot process
PORT=3001
# Optional comma-separated guild IDs that bypass captcha when trusted
TRUSTED_GUILDS=

# Optional: Skip slash command registration on startup (use node registerCommands.js manually)
SKIP_COMMAND_REGISTRATION=false

# Optional: REST timeout (ms) for Discord API calls during command sync
DISCORD_REST_TIMEOUT_MS=120000

# Optional: Hard timeout (ms) for Discord API calls (used for guild command sync)
DISCORD_REST_HARD_TIMEOUT_MS=300000

# Optional: Log heartbeat interval (ms) while a Discord REST call is running
DISCORD_REST_HEARTBEAT_MS=15000

# Optional: Number of retries for guild command operations
DISCORD_REST_RETRIES=2

# Optional: Delay between individual guild command sync requests (ms)
COMMAND_SYNC_DELAY_MS=1250

# Optional: Use direct Discord API fetch (AbortController) for guild command sync
DISCORD_DIRECT_FETCH=true

# Optional: GROQ API key for /ai command configuration
GROQ_API_KEY=

# Optional: Groq model id for /ai (chat)
GROQ_MODEL=

# Optional: Enable safety moderation pass for /ai
GROQ_SAFETY_ENABLED=true

# Optional: Groq model id for safety moderation (default: same as GROQ_MODEL)
GROQ_SAFETY_MODEL=

# Optional: Allowlist of AI tools that can be executed (comma-separated)
AI_TOOL_ALLOWLIST=assignRole,markVerified,logVerification

# Optional: Allowlist of role IDs that AI is allowed to assign (comma-separated). Default: MEMBER_ROLE_ID
AI_ALLOWED_ROLE_IDS=

# Optional: Groq model id for Speech-to-Text (Whisper)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: Force STT language (e.g. id, en)
GROQ_STT_LANGUAGE=

# Optional: Groq model id for Text-to-Speech (Orpheus)
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Optional: Orpheus voice name (see Groq docs). Example: troy, hannah, austin
GROQ_TTS_VOICE=troy

# Optional: Voice verification settings
VOICEVERIFY_DIGITS=3
VOICEVERIFY_MAX_ATTEMPTS=3
VOICEVERIFY_MAX_RECORD_MS=10000
VOICEVERIFY_SILENCE_MS=1200
