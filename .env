# Discord bot token (bot account secret)
DISCORD_TOKEN=your_discord_bot_token_here
# Discord application/client ID used when registering commands
DISCORD_CLIENT_ID=your_discord_client_id_here
# Guild (server) where the verification happens
GUILD_ID=your_guild_id_here
# Role to grant upon successful verification
MEMBER_ROLE_ID=your_member_role_id_here
# Optional staff role ID allowed to run admin commands without needing Manage Server permission
STAFF_ROLE_ID=
# Optional admin role ID (also allowed for staff-only commands)
ADMIN_ROLE_ID=
# Text channel ID where the welcome greeting should be posted
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
# Public URL for the Next.js frontend (used in verification DMs)
PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app
# Base URL for this backend API (consumed by the Next.js frontend)
API_BASE_URL=http://localhost:3001
# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/verification
# Google reCAPTCHA v2 site key (safe to expose to the client)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Google reCAPTCHA v2 secret key (server-side only)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
# Shared secret for accessing the admin dashboard API endpoint
ADMIN_KEY=your_admin_key_here
# Optional: Discord invite or server link opened by the "Open in Browser" button
DISCORD_BROWSER_URL=https://discord.gg/yourserver
# Port for the Express API + bot process
PORT=3001

# 🎵 Music Bot Configuration (NEW)
# Lavalink server configuration (Railway deployment)
LAVALINK_HOST=lavalink-verify.up.railway.app
LAVALINK_PORT=443
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_CLIENT_ID=your_discord_client_id_here
LAVALINK_SECURE=true

# YouTube API key (optional but recommended for better search)
YOUTUBE_API_KEY=AIzaSyAN6ecNTVFGLm4R-83H4qm7VsFsbpzpMRY

# Discord invite link (used in music bot messages)
DISCORD_INVITE_LINK=https://discord.gg/gECYdzVz2j

# 🤖 Groq API Configuration (for voice chat and AI features)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Groq model configuration
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_STT_LANGUAGE=id

# Voice verification settings
VOICEVERIFY_DIGITS=3
VOICEVERIFY_MAX_ATTEMPTS=3
VOICEVERIFY_MAX_RECORD_MS=10000
VOICEVERIFY_SILENCE_MS=1200
